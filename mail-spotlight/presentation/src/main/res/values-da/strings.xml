<resources>
  <string name="spotlight_screen_title">Nyt i Proton Mail</string>
  <string name="spotlight_feature_item_discreet_icon_title">Diskret ikon</string>
  <string name="spotlight_feature_item_discreet_icon_description">Behold standardikonet for Proton Mail, eller maskér den med et generisk ikon for at bedre privatlivsbeskyttelse.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Beskyttelse mod sporing</string>
  <string name="spotlight_feature_item_tracking_protection_description">Se, hvem der forsøgte at overvåge dig med skjulte pixels og sporingslinks, og hvor mange forsøg der blev blokeret.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Krypteringslåse</string>
  <string name="spotlight_feature_item_encryption_locks_description">Brug låseikonerne til at identificere og bekræfte den type kryptering, der beskytter dine beskeder.</string>
  <string name="spotlight_feature_item_headers_html_title">Vis overskrifter og HTML</string>
  <string name="spotlight_feature_item_headers_html_description">Undersøg mistænkelige beskeder for at bekræfte deres ægthed og afsløre eventuelle skjulte sporingskomponenter.</string>
  <string name="spotlight_screen_got_it">Forstået</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Nyt i Proton Mail</string>
  <string name="spotlight_screen_category_view_title_b2b">Se hvad der er nyt\ni Proton Mail</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">UI-forbedringer</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Flydende scrolling, opdateret layout og meget mere.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Ulæst-filter</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Nu placeret i bunden for lettere adgang.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Bedre tilgængelighed med nyt udseende og ny placering.</string>
  <string name="spotlight_screen_category_view_categories_title">E-mail-kategorier</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Sortér automatisk mails i forskellige kategorier.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">Automatisk sortering af indgående mails.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Ulæst er lettere at tilgå</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">Ulæst-filteret er nu placeret i bunden af din indbakke, så det er lettere at tilgå og skifte mellem alle e-mails og ulæste beskeder.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Hold dig opdateret på nye og\nulæste e-mails</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">Ulæst-filteret er nu mere tydeligt og nemmere at tilgå, så du lettere kan gennemgå og handle på ulæste e-mails.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Din indbakke,\nautomatisk organiseret</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Din indbakke er nu sorteret efter kategorier såsom Primær, Social, Reklamer, og mere, se det er lettere at forblive organiseret og fokusere på de vigtige e-mails.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Designet til at være privat. Få mere at vide</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Hej kategorier.\nFarvel forstyrrelser.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Undgå forstyrrelser fra nyhedsbreve, opdateringer, og e-mails der ikke er vigtige. Med de nye e-mail-kategorier er det kun vigtige beskeder der lander i din primære indbakke.</string>
  <string name="spotlight_screen_category_view_button_continue">Fortsæt</string>
  <string name="spotlight_screen_category_view_button_try">Ja, organiser den</string>
  <string name="spotlight_screen_category_view_button_dismiss">Behold indbakken som før</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Søgning er nu blevet bedre</string>
  <string name="spotlight_screen_content_search_subtitle">Find alt det vigtige uden at give op på dit privatliv.</string>
  <string name="spotlight_screen_content_search_message_content_title">Søg efter hvert et ord</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find e-mails efter beskedindhold, ikke bare emnet eller afsenderen.</string>
  <string name="spotlight_screen_content_search_encryption_title">Stadig end-to-end krypteret</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indekseringen sker på din enhed, krypteret med din nøgle. Intet bliver sendt til Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Fortsæt fra hvor du slap</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Find dine seneste søgninger og resultater hurtigt. Opbevaret på din enhed for at beholde end-to-end-kryptering.</string>
  <string name="spotlight_screen_whats_new_pill">Nyheder</string>
  <string name="spotlight_screen_content_search_button_continue">Fortsæt</string>
  <string name="spotlight_screen_content_search_button_turn_on">Slå til</string>
  <string name="spotlight_screen_content_search_button_not_now">Ikke nu</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">Sådan fungerer indholdssøgning</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Dine e-mails bliver downloadet til denne telefon</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">Proton Mail downloader sikkert en kopi til denne enhed, så at du kan søge efter indhold i dine e-mails.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">Et privat indeks bygges på enheden</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">Et leightweight søgeindeks bliver oprettet på din enhed. Tænk på det som en oversigt over de beskeder du leder efter.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">Vi indekserer i baggrunden</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Det vil tage noget tid at indeksere dine e-mails, men du kan fortsætte med at bruge din e-mail som du plejer, mens der arbejdes i baggrunden.</string>
</resources>
