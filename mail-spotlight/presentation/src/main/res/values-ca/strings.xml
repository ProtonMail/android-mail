<resources>
  <string name="spotlight_screen_version_text">Versió %s</string>
  <string name="spotlight_screen_title">Novetats al Proton Mail</string>
  <string name="spotlight_feature_item_discreet_icon_title">Icona discreta</string>
  <string name="spotlight_feature_item_discreet_icon_description">Mantingueu la icona per defecte del Proton Mail o amagueu-la amb una de genèrica per a una major privacitat.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Protecció contra rastrejadors</string>
  <string name="spotlight_feature_item_tracking_protection_description">Vegeu qui us ha intentat monitorar amb píxels amagats i enllaços de seguiment, i quants intents s\'han blocat.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Cadenats de xifratge</string>
  <string name="spotlight_feature_item_encryption_locks_description">Utilitzeu les icones de cadenat per identificar i verificar el tipus de xifratge que protegeix els missatges.</string>
  <string name="spotlight_feature_item_headers_html_title">Mostra les capçaleres i l\'HTML</string>
  <string name="spotlight_feature_item_headers_html_description">Inspeccioneu els missatges sospitosos per confirmar-ne l\'autenticitat i descobrir elements de seguiment ocults.</string>
  <string name="spotlight_screen_got_it">D\'acord</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Novetats a Proton Mail</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Millores de la interfície</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Desplaçament fluid, disseny actualitzat i més.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Filtre de no llegits</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Ara situat a la part inferior per a un accés més fàcil.</string>
  <string name="spotlight_screen_category_view_categories_title">Categories de correu electrònic</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Classifiqueu el correu automàticament en categories útils.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Els missatges no llegits són més fàcils de trobar</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">El filtre de missatges no llegits ara és a la part inferior de la safata d\'entrada, el que fa més fàcil accedir-hi i alternar entre tots els correus i els missatges no llegits.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Estigueu al dia dels correus nous i\nno llegits</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">El filtre de correus no llegits ara és més visible i està a l\'abast de la mà, cosa que us permet escanejar ràpidament i actuar sobre els correus no llegits.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">La vostra bústia d\'entrada,\norganitzada automàticament</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Ara la vostra safata d\'entrada està classificada en categories com Principal, Social, Promocions i més, el que facilita reduir el desordre i centrar-vos en els correus que importen.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Privat per disseny. Més informació</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Hola, categories.\nAdeu, distraccions.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Deixeu de distreure-us amb butlletins, actualitzacions i correus no urgents. Amb les noves categories de correu electrònic, només els missatges importants arriben a la safata d\'entrada principal.</string>
  <string name="spotlight_screen_category_view_button_continue">Continua</string>
  <string name="spotlight_screen_category_view_button_try">Prova les categories</string>
  <string name="spotlight_screen_category_view_button_dismiss">Continuar sense</string>
</resources>
