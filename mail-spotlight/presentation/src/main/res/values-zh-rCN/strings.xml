<resources>
  <string name="spotlight_screen_title">Proton Mail 的新功能</string>
  <string name="spotlight_feature_item_discreet_icon_title">隐藏图标</string>
  <string name="spotlight_feature_item_discreet_icon_description">保留默认的Proton Mail图标，或将其伪装成一个通用的图标以增强隐私性。</string>
  <string name="spotlight_feature_item_tracking_protection_title">跟踪防护</string>
  <string name="spotlight_feature_item_tracking_protection_description">查看谁试图使用隐藏像素和跟踪链接监控您，以及阻止了多少次尝试。</string>
  <string name="spotlight_feature_item_encryption_locks_title">加密锁定</string>
  <string name="spotlight_feature_item_encryption_locks_description">使用锁图标来识别和验证保护您邮件的加密类型。</string>
  <string name="spotlight_feature_item_headers_html_title">查看标题和 HTML</string>
  <string name="spotlight_feature_item_headers_html_description">检查可疑消息以确认其真实性并发现任何隐藏的跟踪元素。</string>
  <string name="spotlight_screen_got_it">了解</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Proton Mail 新增功能</string>
  <string name="spotlight_screen_category_view_title_b2b">探索 Proton Mail 的新功能</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">界面增强</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">流畅滚动、全新布局等更多改进！</string>
  <string name="spotlight_screen_category_view_unread_filter_title">未读筛选器</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">现已移至底部，方便访问。</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">全新外观与位置，更易于访问！</string>
  <string name="spotlight_screen_category_view_categories_title">邮件分类</string>
  <string name="spotlight_screen_category_view_categories_subtitle">自动将邮件归入有用的分类。</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">自动分类收到的邮件！</string>
  <string name="spotlight_screen_category_view_main_b2c_title">未读邮件更易触达</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">未读筛选器现已移至收件箱底部，方便您在全部邮件和未读邮件之间切换。</string>
  <string name="spotlight_screen_category_view_main_b2b_title">随时掌握新邮件和未读邮件</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">未读筛选器现在更加显眼且触手可及，让您快速浏览并对未读邮件采取行动。</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">您的邮箱，\n自动整理</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">您的收件箱现按“主要”、“社交”、“促销”等分类自动整理，帮助减少杂乱，让您专注于重要邮件。</string>
  <string name="spotlight_screen_category_view_privacy_by_design">专为隐私打造。了解详情</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">告别分类，\n告别干扰。</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">不再被资讯、更新和非紧急邮件打扰。有了新的邮件分类功能，只有重要邮件才会进入您的主收件箱。</string>
  <string name="spotlight_screen_category_view_button_continue">继续</string>
  <string name="spotlight_screen_category_view_button_try">是，立即整理</string>
  <string name="spotlight_screen_category_view_button_dismiss">保持收件箱原样</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Search just got better.</string>
  <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
  <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
  <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Pick up where you left off</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
  <string name="spotlight_screen_whats_new_pill">What’s new</string>
  <string name="spotlight_screen_content_search_button_continue">Continue</string>
  <string name="spotlight_screen_content_search_button_turn_on">Turn on</string>
  <string name="spotlight_screen_content_search_button_not_now">Not now</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">How content search works</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Your emails download to this phone</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">To search your email content, Proton Mail securely downloads a copy to this device.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">A private index is built on-device</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">A lightweight search index is created locally on your device. Think of it as a map to find the messages you’re looking for.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">We\'ll index in the background</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Indexing your emails will take some time, but you can keep using mail as usual while we work in the background.</string>
</resources>
