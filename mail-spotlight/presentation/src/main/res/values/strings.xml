<resources>
    <string name="spotlight_screen_title">What’s new in Proton Mail</string>

    <string name="spotlight_feature_item_discreet_icon_title">Discreet icon</string>
    <string name="spotlight_feature_item_discreet_icon_description">Keep the default Proton Mail icon or disguise it with a generic one for greater privacy.</string>
    <string name="spotlight_feature_item_tracking_protection_title">Tracking protection</string>
    <string name="spotlight_feature_item_tracking_protection_description">See who tried to monitor you with hidden pixels and tracking links, and how many attempts were blocked.</string>
    <string name="spotlight_feature_item_encryption_locks_title">Encryption locks</string>
    <string name="spotlight_feature_item_encryption_locks_description">Use the lock icons to identify and verify the type of encryption protecting your messages.</string>
    <string name="spotlight_feature_item_headers_html_title">View headers and HTML</string>
    <string name="spotlight_feature_item_headers_html_description">Inspect suspicious messages to confirm their authenticity and uncover any hidden tracking elements.</string>

    <string name="spotlight_screen_got_it">Got it</string>

    <!-- Category View Spotlight -->
    <string name="spotlight_screen_category_view_title">What\’s new in Proton Mail</string>
    <string name="spotlight_screen_category_view_title_b2b">Discover what\’s new\nin Proton Mail</string>
    <string name="spotlight_screen_category_view_ui_enhancements_title">UI enhancements</string>
    <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Fluid scrolling, refreshed layout, and more.</string>
    <string name="spotlight_screen_category_view_unread_filter_title">Unread filter</string>
    <string name="spotlight_screen_category_view_unread_filter_subtitle">Now located at the bottom for easier access.</string>
    <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">New look and location for easier access.</string>
    <string name="spotlight_screen_category_view_categories_title">Email categories</string>
    <string name="spotlight_screen_category_view_categories_subtitle">Automatically sort mail into helpful categories.</string>
    <string name="spotlight_screen_category_view_categories_subtitle_b2b">Automatic sorting of incoming mail.</string>

    <string name="spotlight_screen_category_view_main_b2c_title">Unread is easier to reach</string>
    <string name="spotlight_screen_category_view_main_b2c_subtitle">The unread filter is now at the bottom of your inbox, making it easier to reach and switch between all emails and unread messages.</string>

    <string name="spotlight_screen_category_view_main_b2b_title">Stay on top of new and\nunread emails</string>
    <string name="spotlight_screen_category_view_main_b2b_subtitle">The unread filter is now more visible and at your fingertips, letting you quickly scan and take action on unread emails.</string>

    <string name="spotlight_screen_category_view_secondary_b2c_title">Your inbox,\nautomatically organized</string>
    <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Your inbox is now sorted into categories like Primary, Social, Promotions, and more, making it easier to reduce clutter and focus on the emails that matter.</string>
    <string name="spotlight_screen_category_view_privacy_by_design">Private by design. Learn more</string>

    <string name="spotlight_screen_category_view_secondary_b2b_title">Hello categories.\nGoodbye distractions.</string>
    <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Stop getting distracted by newsletters, updates, and non-urgent emails. With new email categories, only important messages land in your primary inbox.</string>

    <string name="spotlight_screen_category_view_button_continue">Continue</string>
    <string name="spotlight_screen_category_view_button_try">Yes, organize it</string>
    <string name="spotlight_screen_category_view_button_dismiss">Keep inbox as before</string>

    <!-- Content Search Spotlight -->
    <string name="spotlight_screen_content_search_title">Search just got better.</string>
    <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
    <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
    <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
    <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
    <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
    <string name="spotlight_screen_content_search_recent_searches_title">Pick up where you left off</string>
    <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
    <string name="spotlight_screen_whats_new_pill">What’s new</string>
    <string name="spotlight_screen_content_search_button_continue">Continue</string>
    <string name="spotlight_screen_content_search_button_turn_on">Turn on</string>
    <string name="spotlight_screen_content_search_button_not_now">Not now</string>
</resources>
