<resources>
  <string name="spotlight_screen_title">Proton Mail yenilikleri</string>
  <string name="spotlight_feature_item_discreet_icon_title">Göze çarpmayan simge</string>
  <string name="spotlight_feature_item_discreet_icon_description">Varsayılan Proton Mail simgesini kullanın ya da daha fazla gizlilik için göze çarpmayan bir simgeyle gizleyin.</string>
  <string name="spotlight_feature_item_tracking_protection_title">İzleme koruması</string>
  <string name="spotlight_feature_item_tracking_protection_description">Gizli pikseller ve izleme bağlantıları ile sizi izlemeye çalışanları ve kaç girişimin engellendiğini görün.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Şifreleme kilitleri</string>
  <string name="spotlight_feature_item_encryption_locks_description">İletilerinizi koruyan şifreleme türünü tanımlamak ve doğrulamak için kilit simgelerini kullanın.</string>
  <string name="spotlight_feature_item_headers_html_title">Üst bilgilere ve HTML koduna bakın</string>
  <string name="spotlight_feature_item_headers_html_description">Şüpheli iletileri inceleyerek gerçekliklerini doğrulayın ve gizli izleme ögelerini ortaya çıkarın.</string>
  <string name="spotlight_screen_got_it">Anladım</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Proton Mail yenilikleri</string>
  <string name="spotlight_screen_category_view_title_b2b">Proton Mail \nyeniliklerini öğrenin</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Kullanıcı arayüzü iyileştirmeleri</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Akıcı kaydırma, yenilenmiş yerleşim ve diğer şeyler.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Okunmamış süzgeci</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Daha kolay erişilmesi için sayfanın altına taşındı.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Daha kolay erişim için yeni görünüm ve konumlandırma.</string>
  <string name="spotlight_screen_category_view_categories_title">E-posta kategorileri</string>
  <string name="spotlight_screen_category_view_categories_subtitle">E-postaların size yardımcı olacak şekilde sınıflandırılmasını sağlayın.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">Gelen e-postaların otomatik olarak sıralanması.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Okunmamış iletilere ulaşmak artık daha kolay</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">Okunmamış iletiler süzgeci artık gelen kutunuzun altında bulunuyor. Böylece tüm e-postalara ve okunmamış iletilere daha kolay erişebilir ve bunlar arasında geçiş yapabilirsiniz.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Yeni ve okunmamış e-postaları\nizleyin</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">Artık \"Okunmamış\" süzgeci daha belirgin ve parmaklarınızın ucunda. Böylece okunmamış e-postaları hızla gözden geçirip gerekli işlemleri yapabilirsiniz.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Gelen kutunuz\nkendiliğinden düzenlenir</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Gelen kutunuz artık Birincil, Sosyal, Tanıtımlar ve diğer kategorilere ayrılacak. Böylece gereksiz e-postaları ayıklamak ve önemli e-postalara odaklanmak daha kolay olacak.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Gizlilik odaklı tasarlanmıştır. Ayrıntılı bilgi alın</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Merhaba kategoriler.\nGüle güle dikkat dağınıklığı.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Duyurular, güncellemeler ve acil olmayan e-postalar yüzünden dikkatinizin dağılmasını önleyin. Yeni e-posta kategorileri ile yalnızca önemli iletiler birincil gelen kutunuza düşer.</string>
  <string name="spotlight_screen_category_view_button_continue">İlerle</string>
  <string name="spotlight_screen_category_view_button_try">Evet, düzenle</string>
  <string name="spotlight_screen_category_view_button_dismiss">Gelen kutusu eskisi gibi kalsın</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Arama özelliği daha da iyileşti.</string>
  <string name="spotlight_screen_content_search_subtitle">Gizliliğinizden vazgeçmeden neyin önemli olduğunu bulun.</string>
  <string name="spotlight_screen_content_search_message_content_title">Her e-postadan daha fazlasını bulun</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">E-postaları yalnızca konu başlığına veya göndericiye göre değil, ileti içeriğine göre de bulun.</string>
  <string name="spotlight_screen_content_search_bottom_bar_title">Ulaşması daha kolay</string>
  <string name="spotlight_screen_content_search_bottom_bar_subtitle">Tek elle kolayca kullanılabilmesi için arama özelliği artık ekranın alt bölümünde yer alıyor.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Kaldığınız yerden ilerleyin</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Son aramalarınıza kolayca geri dönün. Uçtan uca şifrelemeyi korumak için veriler aygıtınızda saklanır.</string>
</resources>
