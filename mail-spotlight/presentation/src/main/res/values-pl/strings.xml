<resources>
  <string name="spotlight_screen_title">Co nowego w Proton Mail</string>
  <string name="spotlight_feature_item_discreet_icon_title">Dyskretna ikona</string>
  <string name="spotlight_feature_item_discreet_icon_description">Zachowaj domyślną ikonę Proton Mail lub zamaskuj ją przy użyciu ogólnej ikony dla większej prywatności.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Ochrona przed śledzeniem</string>
  <string name="spotlight_feature_item_tracking_protection_description">Zobacz, kto próbował Cię monitorować za pomocą ukrytych pikseli i linków śledzących oraz ile prób zablokowano.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Kłódki szyfrowania</string>
  <string name="spotlight_feature_item_encryption_locks_description">Używaj ikon kłódek, aby zidentyfikować i zweryfikować typ szyfrowania chroniącego Twoje wiadomości.</string>
  <string name="spotlight_feature_item_headers_html_title">Podgląd nagłówków i HTML</string>
  <string name="spotlight_feature_item_headers_html_description">Sprawdzaj podejrzane wiadomości, aby potwierdzić ich autentyczność i wykryć wszelkie ukryte elementy śledzące.</string>
  <string name="spotlight_screen_got_it">Rozumiem</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Co nowego w Proton Mail</string>
  <string name="spotlight_screen_category_view_title_b2b">Odkryj, co nowego\nw Proton Mail</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Ulepszenia interfejsu użytkownika</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Płynne przewijanie, odświeżony widok i nie tylko.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Filtr nieprzeczytanych</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Teraz znajduje się na dole, aby ułatwić dostęp.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Nowy wygląd i lokalizacja ułatwiające dostęp.</string>
  <string name="spotlight_screen_category_view_categories_title">Kategorie wiadomości</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Automatycznie sortuj wiadomości na przydatne kategorie.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">Automatyczne sortowanie poczty przychodzącej.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Łatwiejszy dostęp do nieprzeczytanych</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">Filtr nieprzeczytanych znajduje się teraz na dole Twojej skrzynki odbiorczej, co ułatwia dostęp i przełączanie się między wszystkimi wiadomościami a nieprzeczytanymi wiadomościami.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Bądź na bieżąco z nowymi i\nnieprzeczytanymi wiadomościami</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">Filtr nieprzeczytanych jest teraz lepiej widoczny i łatwo dostępny, co pozwala szybko przeglądać i zarządzać nieprzeczytanymi wiadomościami.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Twoja skrzynka odbiorcza,\nautomatycznie uporządkowana</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Twoja skrzynka odbiorcza jest teraz podzielona na kategorie, takie jak Główny, Społeczności, Promocje i inne, co ułatwia zachowanie porządku i skupienie się na najważniejszych wiadomościach.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Prywatność w standardzie. Dowiedz się więcej</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Witajcie kategorie.\nŻegnajcie rozpraszacze.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Przestań rozpraszać się newsletterami, powiadomieniami i mniej pilnymi wiadomościami. Dzięki nowym kategoriom wiadomości tylko ważne wiadomości trafią do Twojej głównej skrzynki odbiorczej.</string>
  <string name="spotlight_screen_category_view_button_continue">Kontynuuj</string>
  <string name="spotlight_screen_category_view_button_try">Tak, uporządkuj</string>
  <string name="spotlight_screen_category_view_button_dismiss">Pozostaw skrzynkę odbiorczą bez zmian</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Search just got better.</string>
  <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
  <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
  <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Pick up where you left off</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
  <string name="spotlight_screen_whats_new_pill">What’s new</string>
  <string name="spotlight_screen_content_search_button_continue">Continue</string>
  <string name="spotlight_screen_content_search_button_turn_on">Turn on</string>
  <string name="spotlight_screen_content_search_button_not_now">Not now</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">How content search works</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Your emails download to this phone</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">To search your email content, Proton Mail securely downloads a copy to this device.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">A private index is built on-device</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">A lightweight search index is created locally on your device. Think of it as a map to find the messages you’re looking for.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">We\'ll index in the background</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Indexing your emails will take some time, but you can keep using mail as usual while we work in the background.</string>
</resources>
