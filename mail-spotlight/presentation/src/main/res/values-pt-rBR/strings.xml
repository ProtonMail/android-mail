<resources>
  <string name="spotlight_screen_title">Novidades no Proton Mail</string>
  <string name="spotlight_feature_item_discreet_icon_title">Ícone discreto</string>
  <string name="spotlight_feature_item_discreet_icon_description">Mantenha o ícone padrão do Proton Mail ou disfarce-o com um genérico para maior privacidade.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Proteção contra rastreadores</string>
  <string name="spotlight_feature_item_tracking_protection_description">Veja quem tentou te monitorar com pixels ocultos e links de rastreamento, e quantas tentativas foram bloqueadas.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Bloqueios de criptografia</string>
  <string name="spotlight_feature_item_encryption_locks_description">Use os ícones de cadeado para identificar e verificar o tipo de criptografia que protege suas mensagens.</string>
  <string name="spotlight_feature_item_headers_html_title">Ver cabeçalhos e HTML</string>
  <string name="spotlight_feature_item_headers_html_description">Inspecione mensagens suspeitas para confirmar a autenticidade delas e descobrir quaisquer elementos de rastreamento ocultos.</string>
  <string name="spotlight_screen_got_it">Entendi</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Novidades no Proton Mail</string>
  <string name="spotlight_screen_category_view_title_b2b">Descubra as novidades \ndo Proton Mail</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Melhorias na interface do usuário</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Rolagem fluida, layout atualizado e muito mais.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Filtro de não lido</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Agora está localizado na parte inferior para facilitar o acesso.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Novo visual e localização para facilitar o acesso.</string>
  <string name="spotlight_screen_category_view_categories_title">Categorias de e-mail</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Classifique automaticamente os e-mails em categorias úteis.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">Classificação automática das mensagens recebidas.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">É mais fácil acessar as mensagens não lidas</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">O filtro de mensagens não lidas agora fica na parte inferior da sua caixa de entrada, facilitando o acesso e a alternância entre todos os e-mails e as mensagens não lidas.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Fique por dentro dos e-mails novos e\nnão lidos</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">O filtro de mensagens não lidas agora está mais visível e ao seu alcance, permitindo que você analise rapidamente e tome medidas em relação aos e-mails não lidos.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Sua caixa de entrada,\nautomaticamente organizada</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Sua caixa de entrada agora está organizada em categorias como Principal, Redes sociais, Promoções e outras, facilitando a redução do excesso de mensagens e permitindo que você se concentre nos e-mails que realmente importam.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Privado por design. Saiba mais</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Olá, categorias.\nAdeus, distrações.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Pare de se distrair com boletins informativos, atualizações e e-mails não urgentes. Com as novas categorias de e-mail, apenas mensagens importantes chegam à sua caixa de entrada principal.</string>
  <string name="spotlight_screen_category_view_button_continue">Continuar</string>
  <string name="spotlight_screen_category_view_button_try">Sim, organize</string>
  <string name="spotlight_screen_category_view_button_dismiss">Manter a caixa de entrada como antes</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">A pesquisa agora é melhor</string>
  <string name="spotlight_screen_content_search_subtitle">Encontre o que é importante, sem abrir mão da sua privacidade.</string>
  <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Encontre e-mais por conteúdo de mensagem, não apenas por assunto ou remetente.</string>
  <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Continue de onde parou</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
  <string name="spotlight_screen_whats_new_pill">Novidades</string>
  <string name="spotlight_screen_content_search_button_continue">Continuar</string>
  <string name="spotlight_screen_content_search_button_turn_on">Ativar</string>
  <string name="spotlight_screen_content_search_button_not_now">Agora não</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">How content search works</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Your emails download to this phone</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">To search your email content, Proton Mail securely downloads a copy to this device.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">A private index is built on-device</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">A lightweight search index is created locally on your device. Think of it as a map to find the messages you’re looking for.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">We\'ll index in the background</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Indexing your emails will take some time, but you can keep using mail as usual while we work in the background.</string>
</resources>
