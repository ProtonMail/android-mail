<resources>
  <string name="spotlight_screen_title">Uutta Proton Mailissa</string>
  <string name="spotlight_feature_item_discreet_icon_title">Huomaamaton kuvake</string>
  <string name="spotlight_feature_item_discreet_icon_description">Säilytä Proton Mailin oletuskuvake tai peitä se yleisellä kuvakkeella yksityisyyden suojaamiseksi.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Seurannan suojaus</string>
  <string name="spotlight_feature_item_tracking_protection_description">Katso, kuka yritti seurata sinua piilotettujen pikselien ja seurantalinkkien avulla, ja kuinka monta yritystä estettiin.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Salauslukot</string>
  <string name="spotlight_feature_item_encryption_locks_description">Käytä lukkokuvakkeita tunnistaaksesi ja tarkistaaksesi viestejäsi suojaavan salauksen tyypin.</string>
  <string name="spotlight_feature_item_headers_html_title">Näytä otsakkeet ja HTML</string>
  <string name="spotlight_feature_item_headers_html_description">Tarkista epäilyttävät viestit niiden aitouden varmistamiseksi ja piilotettujen seurantaelementtien paljastamiseksi.</string>
  <string name="spotlight_screen_got_it">Selvä</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Uutta Proton Mailissa</string>
  <string name="spotlight_screen_category_view_title_b2b">Tutustu Proton Mailin\nuutuuksiin</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Käyttöliittymän parannukset</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Sujuva vieritys, uudistettu ulkoasu ja paljon muuta.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Lukemattomat-suodatin</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">Sijaitsee nyt alareunassa, jotta se on helpommin käytettävissä.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Uusi ilme ja sijainti helpottavat käyttöä.</string>
  <string name="spotlight_screen_category_view_categories_title">Viestikategoriat</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Luokittele viestit automaattisesti käteviin kategorioihin.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">Saapuvien viestien automaattinen luokittelu.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Lukemattomat on helpompi tavoittaa</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">Lukemattomat-suodatin löytyy nyt postilaatikkosi alaosasta, josta se löytyy helposti tehden kaikkien ja lukemattomien viestien näyttämisestä helppoa.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Pysy ajan tasalla uusista ja\nlukemattomista viesteistä</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">Lukemattomat-suodatin on nyt näkyvämpi ja helpommin tavoitettavissa esillä, nopeuttaen lukemattomien viestien käsittelyä.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Saapuneet viestisi,\nautomaattisesti järjestettynä</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">Saapuneet-kansiosi on nyt luokiteltu kategorioihin, kuten Ensisijaiset, Some ja Markkinointi, ja tämä helpottaa viestien seulontaa, jolloin voit keskittyä olennaisiin viesteihin.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Suunniteltu yksityiseksi. Lue lisää</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Hei kategoriat.\nHyvästi häiriöt.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Älä anna uutiskirjeiden, päivitysten ja kiireettömien viestien häiritä. Uusien viestikategorioiden ansiosta ensisijaiseen saapuneet-kansioon päätyvät vain tärkeät viestit.</string>
  <string name="spotlight_screen_category_view_button_continue">Jatka</string>
  <string name="spotlight_screen_category_view_button_try">Kyllä, järjestä</string>
  <string name="spotlight_screen_category_view_button_dismiss">Säilytä postilaatikkosi ennallaan</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Hausta tuli juuri parempi.</string>
  <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
  <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
  <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Jatka siitä, mihin jäit</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
  <string name="spotlight_screen_whats_new_pill">What’s new</string>
  <string name="spotlight_screen_content_search_button_continue">Continue</string>
  <string name="spotlight_screen_content_search_button_turn_on">Turn on</string>
  <string name="spotlight_screen_content_search_button_not_now">Not now</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">How content search works</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Your emails download to this phone</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">To search your email content, Proton Mail securely downloads a copy to this device.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">A private index is built on-device</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">A lightweight search index is created locally on your device. Think of it as a map to find the messages you’re looking for.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">We\'ll index in the background</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Indexing your emails will take some time, but you can keep using mail as usual while we work in the background.</string>
</resources>
