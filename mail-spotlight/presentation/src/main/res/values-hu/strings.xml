<resources>
  <string name="spotlight_screen_title">Újdonságok a Proton Mailben</string>
  <string name="spotlight_feature_item_discreet_icon_title">Diszkrét ikon</string>
  <string name="spotlight_feature_item_discreet_icon_description">Tartsa meg az alapértelmezett Proton Mail ikont, vagy álcázza egy általánossal a nagyobb adatvédelem érdekében.</string>
  <string name="spotlight_feature_item_tracking_protection_title">Követés elleni védelem</string>
  <string name="spotlight_feature_item_tracking_protection_description">Nézze meg, ki próbálta megfigyelni rejtett képpontokkal és követő hivatkozásokkal, és hány kísérletet tiltottunk le.</string>
  <string name="spotlight_feature_item_encryption_locks_title">Titkosítási lakatok</string>
  <string name="spotlight_feature_item_encryption_locks_description">Használja a lakat ikonokat az üzeneteit védő titkosítás típusának azonosítására és ellenőrzésére.</string>
  <string name="spotlight_feature_item_headers_html_title">Fejlécek és HTML megtekintése</string>
  <string name="spotlight_feature_item_headers_html_description">Vizsgálja meg a gyanús üzeneteket hitelességük megerősítése és az esetleges rejtett követő elemek felfedése érdekében.</string>
  <string name="spotlight_screen_got_it">Megvan</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Újdonságok a Proton Mailben</string>
  <string name="spotlight_screen_category_view_title_b2b">Fedezze fel a Proton Mail\nújdonságait</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">Felhasználói felület fejlesztései</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">Gördülékeny görgetés, megújult elrendezés és még sok más.</string>
  <string name="spotlight_screen_category_view_unread_filter_title">Olvasatlan szűrő</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">A könnyebb hozzáférés érdekében mostantól alul található.</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">Új megjelenés és helyszín a könnyebb hozzáférésért.</string>
  <string name="spotlight_screen_category_view_categories_title">E-mail kategóriák</string>
  <string name="spotlight_screen_category_view_categories_subtitle">Levelek automatikus rendezése hasznos kategóriákba.</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">A beérkező levelek automatikus rendezése.</string>
  <string name="spotlight_screen_category_view_main_b2c_title">Az olvasatlanok könnyebben elérhetők</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">Az olvasatlan szűrő mostantól a beérkezett üzenetek alján található, így könnyebben elérhető, és egyszerűbb váltani az összes e-mail és az olvasatlan üzenetek között.</string>
  <string name="spotlight_screen_category_view_main_b2b_title">Maradjon naprakész az új és\nolvasatlan e-mailekkel</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">Az olvasatlan szűrő mostantól láthatóbb és karnyújtásnyira van, így gyorsan áttekintheti és kezelheti az olvasatlan e-maileket.</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">Beérkezett üzenetei,\nautomatikusan rendszerezve</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">A beérkezett üzenetek mostantól olyan kategóriákba vannak rendezve, mint az Elsődleges, Közösségi, Promóciók és egyebek, így könnyebben csökkentheti a zsúfoltságot, és a fontos e-mailekre összpontosíthat.</string>
  <string name="spotlight_screen_category_view_privacy_by_design">Alapértelmezetten privát. További információk</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">Üdvözöljük a kategóriákat.\nBúcsút inthet a zavaró tényezőknek.</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">Ne hagyja, hogy a hírlevelek, frissítések és a nem sürgős e-mailek eltereljék a figyelmét. Az új e-mail kategóriákkal csak a fontos üzenetek kerülnek az elsődleges beérkezett üzenetek közé.</string>
  <string name="spotlight_screen_category_view_button_continue">Tovább</string>
  <string name="spotlight_screen_category_view_button_try">Igen, rendszerezem</string>
  <string name="spotlight_screen_category_view_button_dismiss">Hagyja változatlanul a beérkezett üzeneteket</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Search just got better.</string>
  <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
  <string name="spotlight_screen_content_search_message_content_title">Find more in every email</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
  <string name="spotlight_screen_content_search_bottom_bar_title">Easier to reach</string>
  <string name="spotlight_screen_content_search_bottom_bar_subtitle">Search now lives at the bottom of the screen for easy one-handed use.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Pick up where you left off</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Easily revisit recent searches. Stored on your device to preserve end-to-end encryption.</string>
</resources>
