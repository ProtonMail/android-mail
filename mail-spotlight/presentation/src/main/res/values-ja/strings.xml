<resources>
  <string name="spotlight_screen_title">Proton Mailの新機能</string>
  <string name="spotlight_feature_item_discreet_icon_title">目立たないアイコン</string>
  <string name="spotlight_feature_item_discreet_icon_description">Proton Mailのデフォルトアイコンをそのまま使用するか、プライバシーを高めるために一般的なアイコンに偽装してください。</string>
  <string name="spotlight_feature_item_tracking_protection_title">トラッキング防止</string>
  <string name="spotlight_feature_item_tracking_protection_description">隠されたピクセルやトラッキングリンクであなたを監視しようとした人物を確認し、ブロックされた試行回数を確認できます。</string>
  <string name="spotlight_feature_item_encryption_locks_title">暗号化ロック</string>
  <string name="spotlight_feature_item_encryption_locks_description">ロックアイコンを使用して、メッセージを保護する暗号化の種類を特定し、検証してください。</string>
  <string name="spotlight_feature_item_headers_html_title">ヘッダーとHTMLを表示</string>
  <string name="spotlight_feature_item_headers_html_description">疑わしいメッセージを検査して、その正当性を確認し、隠されたトラッキング要素を明らかにします。</string>
  <string name="spotlight_screen_got_it">分かりました</string>
  <!-- Category View Spotlight -->
  <string name="spotlight_screen_category_view_title">Proton Mailの新機能</string>
  <string name="spotlight_screen_category_view_title_b2b">Proton Mailの\n新機能をご覧ください</string>
  <string name="spotlight_screen_category_view_ui_enhancements_title">UIの改善</string>
  <string name="spotlight_screen_category_view_ui_enhancements_subtitle">滑らかなスクロール、刷新されたレイアウトなど。</string>
  <string name="spotlight_screen_category_view_unread_filter_title">未読フィルター</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle">アクセスしやすいよう、下部に配置されました。</string>
  <string name="spotlight_screen_category_view_unread_filter_subtitle_b2b">より簡単にアクセスできるよう、外観と位置が新しくなりました。</string>
  <string name="spotlight_screen_category_view_categories_title">メールカテゴリ</string>
  <string name="spotlight_screen_category_view_categories_subtitle">メールを便利なカテゴリに自動的に振り分けます。</string>
  <string name="spotlight_screen_category_view_categories_subtitle_b2b">受信メールを自動的に分類します。</string>
  <string name="spotlight_screen_category_view_main_b2c_title">未読機能がより簡単に使えます</string>
  <string name="spotlight_screen_category_view_main_b2c_subtitle">未読フィルターが受信トレイの下部に配置され、すべてのメールと未読メッセージの切り替えがより簡単になりました。</string>
  <string name="spotlight_screen_category_view_main_b2b_title">新規や未読のメールを\n常に把握</string>
  <string name="spotlight_screen_category_view_main_b2b_subtitle">未読フィルターがより見やすく身近な場所に配置され、未読メールを素早く確認して処理できるようになりました。</string>
  <string name="spotlight_screen_category_view_secondary_b2c_title">受信トレイを\n自動的に整理</string>
  <string name="spotlight_screen_category_view_secondary_b2c_subtitle">受信トレイがプライマリー、ソーシャル、プロモーションなどのカテゴリに整理され、乱雑さを減らして重要なメールに集中しやすくなりました。</string>
  <string name="spotlight_screen_category_view_privacy_by_design">設計段階からのプライバシー保護。より詳しく</string>
  <string name="spotlight_screen_category_view_secondary_b2b_title">カテゴリ機能が登場。\nもう気が散ることはありません。</string>
  <string name="spotlight_screen_category_view_secondary_b2b_subtitle">ニュースレター、更新情報、緊急性の低いメールに気を取られるのはやめましょう。新しいメールカテゴリ機能により、重要なメッセージのみがプライマリー受信トレイに届きます。</string>
  <string name="spotlight_screen_category_view_button_continue">続ける</string>
  <string name="spotlight_screen_category_view_button_try">はい、整理します</string>
  <string name="spotlight_screen_category_view_button_dismiss">受信トレイを以前のままに保つ</string>
  <!-- Content Search Spotlight -->
  <string name="spotlight_screen_content_search_title">Search just got better.</string>
  <string name="spotlight_screen_content_search_subtitle">Find what matters, without giving up your privacy.</string>
  <string name="spotlight_screen_content_search_message_content_title">Every word, now searchable</string>
  <string name="spotlight_screen_content_search_message_content_subtitle">Find emails by message content, not just subject or sender.</string>
  <string name="spotlight_screen_content_search_encryption_title">Still end-to-end encrypted</string>
  <string name="spotlight_screen_content_search_encryption_subtitle">Indexing happens on your device, encrypted with your key. Nothing is sent to Proton.</string>
  <string name="spotlight_screen_content_search_recent_searches_title">Pick up where you left off</string>
  <string name="spotlight_screen_content_search_recent_searches_subtitle">Quickly revisit recent searches and results. Stored on your device to preserve end-to-end encryption.</string>
  <string name="spotlight_screen_whats_new_pill">What’s new</string>
  <string name="spotlight_screen_content_search_button_continue">Continue</string>
  <string name="spotlight_screen_content_search_button_turn_on">Turn on</string>
  <string name="spotlight_screen_content_search_button_not_now">Not now</string>
  <!-- How email content search works -->
  <string name="spotlight_screen_content_search_how_it_works_title">How content search works</string>
  <string name="spotlight_screen_content_search_how_it_works_download_title">Your emails download to this phone</string>
  <string name="spotlight_screen_content_search_how_it_works_download_subtitle">To search your email content, Proton Mail securely downloads a copy to this device.</string>
  <string name="spotlight_screen_content_search_how_it_works_index_title">A private index is built on-device</string>
  <string name="spotlight_screen_content_search_how_it_works_index_subtitle">A lightweight search index is created locally on your device. Think of it as a map to find the messages you’re looking for.</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_title">We\'ll index in the background</string>
  <string name="spotlight_screen_content_search_how_it_works_search_now_subtitle">Indexing your emails will take some time, but you can keep using mail as usual while we work in the background.</string>
</resources>
