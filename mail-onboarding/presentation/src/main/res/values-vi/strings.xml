<resources>
  <!--  New Onboarding 1  -->
  <string name="onboarding_welcome_title">Chào mừng bạn đến với Proton Mail, nơi quyền riêng tư luôn được đảm bảo theo mặc định</string>
  <string name="onboarding_welcome_description">Trải nghiệm thư đã mã hóa, ít thư rác hơn, bảo vệ chống lừa đảo và chặn trình theo dõi. Chào mừng bạn đến với thế giới quyền riêng tư.</string>
  <!--  New Onboarding 2  -->
  <string name="onboarding_rebuilt_title">Tập trung trong tầm tay</string>
  <string name="onboarding_rebuilt_description">Rút ngắn thời gian sắp xếp để dành nhiều thời gian hơn cho công việc. Hộp thư đến được thiết kế dễ điều hướng hơn, giúp bạn nhanh chóng tiếp cận những gì quan trọng.</string>
  <!--  New Onboarding 3  -->
  <string name="onboarding_feedback_title">Duy trì kết nối, ngay cả khi ngoại tuyến</string>
  <string name="onboarding_feedback_description">Đọc, viết và quản lý email ở mọi nơi. Mọi thứ được tự động đồng bộ ngay khi bạn trực tuyến trở lại.</string>
  <!--  Onboarding actions  -->
  <string name="onboarding_next">Tiếp</string>
