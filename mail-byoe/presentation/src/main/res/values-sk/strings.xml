  <string name="byoe_spotlight_treatment2_benefit_no_edit">Váš Gmail nebudeme upravovať ani vymazávať</string>
  <string name="byoe_spotlight_treatment2_benefit_disconnect">Odpojiť sa môžete kedykoľvek, nič sa nepokazí</string>
