<resources>
  <string name="byoe_gmail_connection_title">Connect your Gmail</string>
  <string name="byoe_gmail_connection_error">Your Gmail account couldn\'t be connected. Please try again.</string>
  <string name="byoe_gmail_connection_retry">Try again</string>
  <!-- Shown when the Gmail connection succeeded -->
  <string name="byoe_gmail_connected_title">Gmail connected</string>
  <string name="byoe_gmail_connected_stay_on_top_title">Stay on top of your Gmail here</string>
  <string name="byoe_gmail_connected_stay_on_top_body">Receive, read and send without switching apps</string>
  <string name="byoe_gmail_connected_notifications_title">Turn off notifications in the Gmail app</string>
  <string name="byoe_gmail_connected_notifications_body">So you only get notified once</string>
  <string name="byoe_gmail_connected_import_title">Importing your emails</string>
  <string name="byoe_gmail_connected_import_body">It runs in the background, so go ahead and use the app. We\'ll notify you once it\'s done.</string>
  <string name="byoe_gmail_connected_import_learn_more">Learn what gets imported.</string>
  <string name="byoe_gmail_connected_older_emails_title">Older emails stay in Gmail</string>
  <string name="byoe_gmail_connected_older_emails_body">Want them here too? Import anytime in Settings.</string>
  <string name="byoe_gmail_connected_open_inbox">Take me to Inbox</string>
  <!-- What gets imported, opened from "Learn what gets imported" on the Gmail connected page -->
  <string name="byoe_import_info_title">What gets imported</string>
  <string name="byoe_import_info_subtitle">Your Gmail account stays as it is. Nothing there is edited or deleted.</string>
  <string name="byoe_import_info_label_lead">All your Gmail in one label.</string>
  <string name="byoe_import_info_label_body">Imported emails are under the %s label.</string>
  <string name="byoe_import_info_label_body_no_address">Imported emails are under the label named after your Gmail address.</string>
  <string name="byoe_import_info_folders_lead">Your labels and folders.</string>
  <string name="byoe_import_info_folders_body">They come over just as you set them up in Gmail.</string>
  <string name="byoe_import_info_filters_lead">Filters and rules stay behind.</string>
  <string name="byoe_import_info_filters_body">You can set up new ones in Settings.</string>
  <!-- Snackbar in the mailbox once the user is back from the success page -->
  <string name="byoe_gmail_import_in_progress">Importing in progress…</string>
  <!-- Mailbox banner while a Gmail import is paused because storage is full -->
  <string name="byoe_storage_banner_title">Storage limit reached</string>
  <string name="byoe_storage_banner_body">Import is paused due to storage limit. Upgrade and get more storage to finish your import.</string>
  <string name="byoe_storage_banner_upgrade">Upgrade</string>
  <string name="byoe_storage_banner_not_now">Not now</string>
  <!-- BYOE spotlight for existing users -->
  <string name="byoe_spotlight_badge">What\'s new</string>
  <string name="byoe_spotlight_title">Use Gmail in Proton</string>
  <string name="byoe_spotlight_subtitle">Import existing emails and sync future ones from Gmail.</string>
  <string name="byoe_spotlight_benefit_read">Read, reply, and stay on top of Gmail</string>
  <string name="byoe_spotlight_benefit_no_ads">No ads, no trackers</string>
  <string name="byoe_spotlight_benefit_no_tracking">Google can\'t track what you do in Proton</string>
  <string name="byoe_spotlight_import_title">Import your emails</string>
  <string name="byoe_spotlight_import_body">Start with your most recent</string>
  <string name="byoe_spotlight_connect">Connect and import</string>
  <string name="byoe_spotlight_later">Not now</string>
  <string name="byoe_spotlight_permissions_note">Next: approve all permissions. Proton never asks for permission to edit or delete anything in your Gmail</string>
