  <string name="byoe_gmail_connection_retry">Zkusit znovu</string>
  <string name="byoe_gmail_connection_cancel">Zrušit</string>
  <!-- Shown when the Gmail connection succeeded -->
  <string name="byoe_gmail_connected_title">Gmail je připojen</string>
  <string name="byoe_gmail_connected_stay_on_top_title">Mějte Gmail pod kontrolou přímo zde</string>
  <string name="byoe_gmail_connected_stay_on_top_body">Přijímejte, čtěte a odesílejte bez přepínání mezi aplikacemi</string>
  <string name="byoe_gmail_connected_notifications_title">Vypněte oznámení v aplikaci Gmail</string>
  <string name="byoe_gmail_connected_notifications_body">Oznámení tak dostanete jen jednou</string>
  <string name="byoe_gmail_connected_import_title">Probíhá import e-mailů</string>
  <string name="byoe_gmail_connected_import_body">Import probíhá na pozadí, takže můžete aplikaci klidně používat. Po jeho dokončení vám pošleme oznámení.</string>
  <string name="byoe_gmail_connected_import_learn_more">Zjistěte, co se importuje.</string>
