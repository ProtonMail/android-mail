  <string name="byoe_storage_banner_title">Bylo dosaženo limitu úložiště</string>
  <string name="byoe_storage_banner_body">Import byl pozastaven, protože bylo dosaženo limitu úložiště. Pro dokončení importu navyšte tarif a získejte více úložiště.</string>
  <string name="byoe_storage_banner_upgrade">Navýšit</string>
  <string name="byoe_storage_banner_not_now">Nyní ne</string>
