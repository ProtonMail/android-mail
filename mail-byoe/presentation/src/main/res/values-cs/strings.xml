  <!-- What gets imported, opened from "Learn what gets imported" on the Gmail connected page -->
  <string name="byoe_import_info_title">Co se importuje</string>
  <string name="byoe_import_info_subtitle">Účet Gmail zůstane beze změny. Nic v něm nebude upraveno ani smazáno.</string>
  <string name="byoe_import_info_label_lead">Celý váš Gmail pod jedním štítkem.</string>
  <string name="byoe_import_info_label_body">Importované e-maily najdete pod štítkem %s.</string>
