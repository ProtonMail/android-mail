  <string name="byoe_spotlight_benefit_no_ads">Žádné reklamy ani sledovací prvky</string>
  <string name="byoe_spotlight_benefit_no_tracking">Google nemůže sledovat, co v Protonu děláte</string>
  <string name="byoe_spotlight_import_title">Importujte e-maily</string>
  <string name="byoe_spotlight_import_body">Začněte těmi nejnovějšími</string>
  <string name="byoe_spotlight_connect_and_import">Připojit a importovat</string>
  <string name="byoe_spotlight_connect">Připojit</string>
  <string name="byoe_spotlight_later">Nyní ne</string>
  <string name="byoe_spotlight_permissions_note">Dále: schvalte všechna oprávnění. Proton nikdy nežádá o oprávnění cokoli ve vašem Gmailu upravovat nebo mazat.</string>
  <!-- BYOE intro and spotlight, Treatment 2 copy -->
  <string name="byoe_spotlight_treatment2_subtitle">Připojte Gmail a o zbytek se postaráme.</string>
  <string name="byoe_spotlight_treatment2_benefit_gmail_address">Přijímejte a pište e-maily ze své adresy Gmail. Vše přímo v Proton Mail.</string>
  <string name="byoe_spotlight_treatment2_benefit_no_edit">Ve vašem Gmailu nic neupravíme ani nesmažeme</string>
  <string name="byoe_spotlight_treatment2_benefit_disconnect">Odpojit se můžete kdykoli a nic se nepokazí</string>
  <string name="byoe_spotlight_treatment2_permissions_note">Dále: Google vás požádá o schválení všech oprávnění. Schvalte je všechna, aby připojení fungovalo.</string>
</resources>
